import secrets
import string

def gerar_senha(tamanho=16):
    caracteres = (
        string.ascii_letters +
        string.digits +
        "!@#$%^&*()-_=+"
    )

    senha = ''.join(secrets.choice(caracteres) for _ in range(tamanho))
    return senha

# Exemplo de uso
senha = gerar_senha(20)
print("Senha segura:", senha)
